{
  "name": "movie-memory",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:local": "node scripts/local-db.mjs",
    "setup:local": "node scripts/setup-local.mjs",
    "test:integration": "tsx scripts/smoke-local.ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "^17.2.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.6",
    "next-auth": "5.0.0-beta.32",
    "openai": "7.54.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "embedded-postgres": "18.6.0-beta.19",
    "prettier": "^3.9.10",
    "prisma": "7.10.1",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  }
}
